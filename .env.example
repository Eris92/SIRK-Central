SIRK_BIND_HOST=127.0.0.1
SIRK_PORT=8080
SIRK_PUBLIC_ORIGIN=https://central.sirkportal.com
SIRK_ADMIN_USERNAME=admin
# Generated by the installer or deploy/reset-breakglass-password.sh. Do not paste plaintext here.
SIRK_ADMIN_PASSWORD_HASH=''
# Generated by the installer or deploy/rotate-access-key.sh.
SIRK_ACCESS_KEY_HASH=''
SIRK_DATA_DIR=/var/lib/sirk-central
SIRK_SESSION_ABSOLUTE_HOURS=8
SIRK_WEBSITE_DOMAIN=sirkportal.com
SIRK_CENTRAL_DOMAIN=central.sirkportal.com
SIRK_AUTH_DOMAIN=auth.sirkportal.com
SIRK_AUTH_ORIGIN=https://auth.sirkportal.com
SIRK_ENTRA_TENANT=organizations
SIRK_ENTRA_CLIENT_ID=''
# Supply through deploy/configure-auth.sh; never commit a real client secret.
SIRK_ENTRA_CLIENT_SECRET=''
SIRK_ENTRA_ADMIN_IDENTITIES='TENANT_ID:OBJECT_ID'
# Generated by the installer. Central and auth must use the same value.
SIRK_SSO_SHARED_SECRET=''
# Generated by the installer; required for the HMAC audit chain.
SIRK_AUDIT_INTEGRITY_KEY=''
SIRK_ACME_EMAIL=admin@sirkportal.com
