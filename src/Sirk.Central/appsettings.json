{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Sirk": {
    "ReverseProxy": {
      "TrustAll": false
    },
    "PortalProtocol": {
      "DataRoot": "data",
      "RegistryFileName": "portals.net10.json",
      "TokenHashIterations": 310000,
      "HeartbeatIntervalSeconds": 60,
      "OfflineAfterSeconds": 180,
      "MaximumClockSkewSeconds": 300,
      "MaximumHeartbeatBodyBytes": 65536,
      "BootstrapPortalId": "",
      "BootstrapPortalName": "",
      "BootstrapPortalToken": ""
    },
    "Security": {
      "Enabled": false,
      "DataRoot": "data/security",
      "IdentityFileName": "identity.net10.json",
      "AuditFileName": "security-audit.net10.jsonl",
      "AuditKeyFileName": "security-audit.net10.key",
      "DataProtectionDirectoryName": "data-protection",
      "DataProtectionCertificatePath": "",
      "DataProtectionCertificatePasswordFile": "",
      "RequireProtectedDataProtectionKeys": true,
      "BootstrapSecretFile": "",
      "PasswordHashIterations": 600000,
      "SessionMinutes": 30,
      "LoginAttemptsPerFiveMinutes": 5,
      "RequireSingleWriterLease": true,
      "WriterLeaseFileName": ".sirk-central-writer.lock",
      "ReleaseSigningPublicKeyFile": "",
      "RequireSignedReleases": true
    }
  }
}
