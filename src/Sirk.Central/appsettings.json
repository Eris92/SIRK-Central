{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Sirk": {
    "ReverseProxy": {
      "TrustAll": false
    },
    "PortalProtocol": {
      "DataRoot": "data",
      "RegistryFileName": "portals.net10.json",
      "TokenHashIterations": 310000,
      "HeartbeatIntervalSeconds": 60,
      "OfflineAfterSeconds": 180,
      "MaximumClockSkewSeconds": 300,
      "MaximumHeartbeatBodyBytes": 65536,
      "BootstrapPortalId": "",
      "BootstrapPortalName": "",
      "BootstrapPortalToken": ""
    }
  }
}
