FROM node:22.18.0-alpine3.22

RUN apk add --no-cache tar gzip

WORKDIR /app
COPY updater/management-server.js /app/management-server.js
COPY updater/backup-archive.js /app/backup-archive.js

RUN mkdir -p /var/lib/sirk-updater /var/lib/sirk-central \
    && chmod 0700 /var/lib/sirk-updater /var/lib/sirk-central

USER root
EXPOSE 8091
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8091/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "/app/management-server.js"]
